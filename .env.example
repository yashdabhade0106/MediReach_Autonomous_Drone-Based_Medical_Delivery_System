# ═══════════════════════════════════════════════════════════
# MediReach — Autonomous Drone Medical Delivery System
# Environment Configuration Template
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# ═══════════════════════════════════════════════════════════

# === SECURITY KEYS ===
SECRET_KEY=your-flask-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here
AES_KEY=your-32-byte-base64-aes-key-here
HMAC_SECRET=your-hmac-secret-key-here

# === DATABASE ===
DATABASE_URL=sqlite:///medireach.db
# For production MySQL:
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/medireach

# === REDIS ===
REDIS_URL=redis://localhost:6379/0

# === MQTT ===
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# === TEAM A INTEGRATION ===
TEAM_A_API_BASE_URL=http://localhost:3000/api
TEAM_A_WEBHOOK_URL=http://localhost:3000/webhook/delivery
TEAM_A_API_KEY=team-a-api-key-here

# === MODEL PATHS ===
RL_MODEL_PATH=models/rl/medireach_ppo_final.zip
CV_MODEL_PATH=models/cv/medireach_yolov8.pt
CV_ONNX_MODEL_PATH=models/cv/medireach_yolov8.onnx

# === SIMULATION ===
USE_AIRSIM=false
SIMULATION_MODE=true
HARDWARE_MODE=false

# === DRONE CONFIG ===
DRONE_ID=DRN-001
DRONE_MAX_ALTITUDE=100
DRONE_MAX_SPEED_MS=15
DRONE_HOME_LAT=18.5204
DRONE_HOME_LONG=73.8567
DRONE_MAX_RANGE_KM=25

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FILE=logs/medireach.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# === RL TRAINING ===
RL_TOTAL_TIMESTEPS=500000
RL_EVAL_FREQ=10000
RL_CHECKPOINT_FREQ=50000
RL_STOP_REWARD_THRESHOLD=90

# === CV TRAINING ===
CV_EPOCHS=100
CV_BATCH_SIZE=16
CV_IMAGE_SIZE=640
CV_CONFIDENCE_THRESHOLD=0.65
